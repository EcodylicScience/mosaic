class Abort(Exception):
    """Signal a refusal or abort, which ends the run with exit 2 and one
    `mutate: <message>` line per message."""

    def __init__(self, *messages: str) -> None:
        super().__init__(*messages)
        self.messages: tuple[str, ...] = messages


class Disconnected(Abort):
    """The parent process or the connection on stdout went away."""


class TimedOut(Exception):
    """A runner ran past its time limit."""


